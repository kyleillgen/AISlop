{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "aislop.flowpocket",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 41823,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": ["app.exit", "window.setAlwaysOnTop", "window.setSize", "window.getSize", "window.move", "window.getPosition", "window.show", "window.unminimize", "window.isMinimized", "window.minimize", "window.beginDrag", "filesystem.readFile", "filesystem.appendFile", "filesystem.getStats", "os.getEnv"],
  "modes": {
    "window": {
      "title": "Flow Pocket",
      "width": 440,
      "height": 660,
      "minWidth": 340,
      "minHeight": 460,
      "center": false,
      "resizable": true,
      "borderless": true,
      "alwaysOnTop": false,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "flow-pocket",
    "resourcesPath": "/resources/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
